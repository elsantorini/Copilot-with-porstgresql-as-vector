# OpenAI / Azure settings
openai_endpoint = "https://your-openai-instance.openai.azure.com/"
openai_key = "your-azure-openai-key"
openai_type = "azure"
openai_version = "2023-12-01-preview"
AZURE_OPENAI_CHAT_MODEL = "gpt-4o"

# Embedding model (choose one)
openai_embeddings_deployment = "text-embedding-ada-002"  # 1536 dims
embeddingsize = "1536"

# Alternative embedding model (uncomment to use)
# openai_embeddings_deployment = "text-embedding-3-large"  # 3072 dims
# embeddingsize = "3072"

# PostgreSQL connection
pgdbname = "your_database_name"
pguser = "your_database_user"
pgpassword = "your_secure_password"
pghost = "your-postgresql-host.postgres.database.azure.com"
pgport = "5432"
